# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real keys.

# --- Required: Supabase (RAG corpus + retrieval) ---------------------------
# Free tier: 500MB database, ~ample for a document-chunk corpus.
# Project settings -> API. Use the SERVICE ROLE key (server-only, never
# expose it with a NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Required: Google Gemini embeddings -------------------------------------
# Free tier available for gemini-embedding-001. Get a key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional override, defaults to "gemini-embedding-001" if unset.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Required: Groq (chat/answer generation, "Grok" in casual speech but
# this codebase actually calls Groq's API via groq-sdk, not xAI's Grok) ----
# Free tier with generous rate limits. Get a key at https://console.groq.com
GROQ_API_KEY=

# --- Optional: web search fallback (hybrid RAG) ------------------------------
# Used when the indexed documents don't cover a query well enough - the app
# answers from a live web search instead and labels the answer + citations
# as web-sourced.  Leave both unset to disable the feature (app still works,
# it'll just say a query is outside the indexed dataset).
#
# Preferred: Google Programmable Search Engine (Custom Search JSON API) -
# free, 100 queries/day, NO credit card required.
#   1. https://programmablesearchengine.google.com/controlpanel/all -> Add
#      -> enable "Search the entire web" -> copy the Search engine ID (cx)
#   2. https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#      -> Enable -> Credentials -> Create API key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Alternative: Tavily (richer results, but its free tier requires a card on
# file for identity verification). Only used if the two vars above aren't
# set. Get a key at https://app.tavily.com/home
TAVILY_API_KEY=

# --- Optional: base URL for internal self-fetches ---------------------------
# Used by the "feasibility" chat mode to call /api/feasibility and
# /api/analyze-drawing on itself. Those two routes don't exist in this repo
# yet (see the debugging notes), so this currently has no effect either way.
# Set it to your deployed origin (e.g. https://your-app.vercel.app) once
# those routes exist. Leave blank for local dev (http://localhost:3000).
NEXT_PUBLIC_BASE_URL=

# --- Not currently used by any live code path --------------------------------
# These appear in package.json / scattered files but only inside code that
# isn't imported by any page or API route in this repo right now:
#   OPENAI_API_KEY   - only referenced in lib/utils/clauseExtractor.ts (orphaned)
#   GEMINI_API_KEY    - only referenced in lib/geminiRag.ts (orphaned)
#   GROQ_MODEL        - only read by lib/groq.ts / groqLandAnalysisService.ts (orphaned)
#   NEXT_PUBLIC_GROQ_API_KEY - do NOT set this; see debugging notes on why a
#                              NEXT_PUBLIC_ Groq key would leak to the browser.

# --- Optional: self-hosted voice service (voice conversation) --------------
# Powers natural-sounding text-to-speech in hands-free voice mode (see
# voice-service/ + app/api/tts/route.ts + lib/useVoiceChat.ts). Currently
# CosyVoice2 (previously Chatterbox - the env var name below is kept as-is
# for compatibility). Free/open-source - you run it yourself, no
# per-character billing. Leave unset and voice mode still works, just
# falls back to the browser's own built-in (more robotic) voice. See
# voice-service/README.md for setup, including an honest performance note.
CHATTERBOX_TTS_URL=

# --- Optional: full-duplex voice agent (voice-agent/, Pipecat) -------------
# The "full rewrite" voice pipeline: continuous local Whisper STT + Silero
# VAD + real barge-in, instead of the browser's Speech Recognition. Heavier
# to run (see voice-agent/README.md) - leave both unset and the app behaves
# exactly as it does today, including the voice mode above (CHATTERBOX_TTS_URL).
# NEXT_PUBLIC_ prefix is required: the browser needs this URL to open the
# WebSocket directly.
NEXT_PUBLIC_VOICE_AGENT_URL=
# Used by voice-agent/bot.py (not the Next.js app itself) to reach this app's
# new OpenAI-compatible shim - see app/api/voice-llm/route.ts.
RAG_LLM_URL=
