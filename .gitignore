# Chatterbox voice service (voice-service/) - Python venv, cache, and any
# personal reference-voice clip shouldn't be committed.
voice-service/venv/
voice-service/__pycache__/
voice-service/*.wav
voice-service/.env

# Build artifacts
tsconfig.tsbuildinfo

# Python (voice-agent mirrors voice-service above)
voice-agent/venv/

# Cloned CosyVoice dependency (git clone --recursive, ~88MB incl. the
# Matcha-TTS submodule) - fetched fresh per README, not project source.
voice-service/CosyVoice/
__pycache__/
*.pyc

# Throwaway patch scripts from earlier AI-assisted edits - not part of the
# project. Safe to delete from the working tree at any time.
scripts/_tmp_*.py
scripts/_to_delete/
stabilization-report.json
.tmp-test/

# Offline local RAG service (local-rag/) - Python venv and generated
# indexes (Qdrant store, BM25 pickle, chunk jsonl, log files) are
# machine-local build output, not source.
local-rag/venv/
local-rag/data/
local-rag/reports/
local-rag/__pycache__/
# Uploaded/generated document store (original.pdf, current.pdf,
# paragraphs.json, report_meta.json per doc/report id) - runtime
# data from real uploads and compliance reports, not source, and
# large (100s of MB). Same category as data/ and reports/ above.
local-rag/documents/

# Copied from node_modules/pdfjs-dist by the copy-pdf-worker script
# (package.json predev/prebuild) - see components/chat/DocumentPanel.tsx's
# worker-setup comment for why it has to be a plain public/ static file
# rather than webpack-bundled. Regenerated automatically, so not committed.
public/pdf.worker.min.mjs
